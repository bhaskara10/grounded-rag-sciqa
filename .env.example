# All configuration is environment-driven; these are the defaults.

# where the persistent chunk/embedding index lives
SCIQA_INDEX_DIR=index

# bi-encoder model name, or "hashing" for the deterministic no-download encoder
SCIQA_ENCODER=sentence-transformers/all-MiniLM-L6-v2

# cross-encoder model name, or "lexical" for the deterministic reranker
SCIQA_RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2

# adaptive evidence selection threshold (sigmoid-calibrated reranker score)
SCIQA_MIN_RERANK_SCORE=0.5
